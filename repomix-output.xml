/* src/app/globals.css */
@tailwind base;
@tailwind components;
@tailwind utilities;

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

@layer base {
  * {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    @apply font-sans text-slate-700;
    background: linear-gradient(135deg, #e0f7f2 0%, #d5eff5 25%, #e8f4f0 50%, #dceef4 75%, #e2f5f0 100%);
    background-attachment: fixed;
    min-height: 100vh;
  }

  ::selection {
    @apply bg-teal-200 text-teal-900;
  }

  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    @apply bg-transparent;
  }
  ::-webkit-scrollbar-thumb {
    @apply bg-teal-300/50 rounded-full;
  }
}

@layer components {
  /* Glassmorphic card — the key visual element */
  .glass {
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
  }

  .glass-hover {
    @apply hover:shadow-lg hover:shadow-teal-200/20 transition-all duration-300;
  }

  .card {
    @apply glass rounded-2xl p-6 shadow-sm shadow-teal-100/50;
  }

  .card-hover {
    @apply card glass-hover cursor-pointer;
  }

  .btn-primary {
    @apply px-5 py-2.5 bg-teal-600 hover:bg-teal-500 text-white rounded-xl font-medium
    transition-all duration-200 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed
    shadow-md shadow-teal-600/20;
  }

  .btn-danger {
    @apply px-5 py-2.5 bg-red-500 hover:bg-red-400 text-white rounded-xl font-medium
    transition-all duration-200 active:scale-[0.98] shadow-md shadow-red-500/20;
  }

  .btn-ghost {
    @apply px-5 py-2.5 bg-white/60 hover:bg-white/80 text-slate-600 rounded-xl font-medium
    border border-white/70 transition-all duration-200 shadow-sm;
  }

  .input {
    @apply w-full px-4 py-3 bg-white/60 border border-teal-100 rounded-xl
    text-slate-700 placeholder-slate-400 focus:outline-none focus:border-teal-400
    focus:ring-2 focus:ring-teal-200 transition-all duration-200 shadow-sm;
  }

  .select {
    @apply input appearance-none cursor-pointer;
  }

  .badge {
    @apply inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold border;
  }

  .stat-card {
    @apply card flex flex-col gap-2;
  }

  .progress-bar {
    @apply h-2.5 rounded-full bg-teal-100/60 overflow-hidden;
  }

  .pulse-dot {
    @apply relative flex h-3 w-3;
  }

  .pulse-dot::before {
    content: '';
    @apply absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75 animate-ping;
  }

  .pulse-dot::after {
    content: '';
    @apply relative inline-flex rounded-full h-3 w-3 bg-red-500;
  }

  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
}

/* Leaflet overrides for light theme */
.leaflet-container {
  background: #e8f4f0 !important;
  border-radius: 1rem;
}

.leaflet-popup-content-wrapper {
  background: rgba(255, 255, 255, 0.9) !important;
  backdrop-filter: blur(12px) !important;
  color: #334155 !important;
  border-radius: 1rem !important;
  border: 1px solid rgba(255, 255, 255, 0.7) !important;
  box-shadow: 0 8px 32px rgba(0, 128, 128, 0.08) !important;
}

.leaflet-popup-tip {
  background: rgba(255, 255, 255, 0.9) !important;
}

.leaflet-control-zoom a {
  background: rgba(255, 255, 255, 0.85) !important;
  color: #334155 !important;
  border-color: rgba(255, 255, 255, 0.7) !important;
}
