// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== AUTH MODELS =====

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  image       String?
  role        Role     @default(CITIZEN)
  phone       String?
  skills      String? // comma-separated: "Nurse,Driver,Cook"
  isVerified  Boolean  @default(false)
  karmaPoints Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bio     String? @db.Text
  address String?

  // Relations
  incidents      Incident[]
  responses      IncidentResponse[]
  messages       Message[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  missingReports MissingPerson[]
  donations      Donation[]
  communityPosts CommunityPost[]
  postComments   PostComment[]
  tasksCreated   Task[]             @relation("TaskCreator")
  tasksAssigned  Task[]             @relation("TaskAssignee")
  supplyRequests SupplyRequest[]    @relation("SupplyRequester")
  supplyApproved SupplyRequest[]    @relation("SupplyApprover")
  areaAlerts     AreaAlert[]
}

enum Role {
  CITIZEN
  VOLUNTEER
  STAFF
  ADMIN
}

// ===== INCIDENT MODELS =====

model Incident {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  type        DisasterType
  severity    Severity
  status      IncidentStatus @default(PENDING)
  latitude    Float
  longitude   Float
  areaName    String?
  address     String?
  imageUrl    String?
  isAnonymous Boolean        @default(false)
  reporterIp  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  reporterId String?
  reporter   User?              @relation(fields: [reporterId], references: [id])
  responses  IncidentResponse[]
  messages   Message[]
  auditLogs  AuditLog[]
  tasks      Task[]
}

enum DisasterType {
  FIRE
  FLOOD
  EARTHQUAKE
  STORM
  MEDICAL
  INFRASTRUCTURE
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  PENDING
  VERIFIED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

// ===== RESPONSE & AUDIT =====

model IncidentResponse {
  id        String   @id @default(cuid())
  message   String   @db.Text
  createdAt DateTime @default(now())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // e.g., "STATUS_CHANGED", "VERIFIED", "ASSIGNED"
  details   String?  @db.Text
  createdAt DateTime @default(now())

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
}

// ===== CHAT / MESSAGING =====

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
}

// ===== NOTIFICATIONS =====

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("INFO") // INFO, SOS, ALERT, RESUPPLY
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

// ===== RESOURCE MANAGEMENT =====

model Shelter {
  id          String   @id @default(cuid())
  name        String
  address     String
  latitude    Float
  longitude   Float
  maxCapacity Int
  occupied    Int      @default(0)
  status      String   @default("OPEN") // OPEN, FULL, CLOSED
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplies           Supply[]
  supplyRequestsFrom SupplyRequest[] @relation("SupplySource")
  supplyRequestsTo   SupplyRequest[] @relation("SupplyDest")
}

model Supply {
  id        String         @id @default(cuid())
  name      String // "Water", "Food Packs", "Medicine"
  category  SupplyCategory
  quantity  Int
  unit      String // "liters", "packs", "boxes"
  minLevel  Int            @default(10) // threshold for alert
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  shelterId String
  shelter   Shelter @relation(fields: [shelterId], references: [id], onDelete: Cascade)
}

enum SupplyCategory {
  FOOD
  WATER
  MEDICINE
  EQUIPMENT
  CLOTHING
  OTHER
}

// ===== MISSING PERSONS =====

model MissingPerson {
  id            String   @id @default(cuid())
  name          String
  age           Int
  gender        String
  description   String   @db.Text
  lastSeenPlace String
  lastSeenDate  DateTime
  imageUrl      String?
  contactPhone  String
  contactName   String
  status        String   @default("MISSING") // MISSING, FOUND, CLOSED
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reporterId String?
  reporter   User?   @relation(fields: [reporterId], references: [id])
}

// ===== DONATIONS =====

model Donation {
  id         String   @id @default(cuid())
  donorName  String
  donorEmail String?
  donorPhone String?
  type       String // MONEY, FOOD, CLOTHING, MEDICINE, EQUIPMENT, OTHER
  amount     Float? // for money donations
  itemName   String? // for non-money donations
  quantity   Int?
  unit       String?
  message    String?
  status     String   @default("PLEDGED") // PLEDGED, RECEIVED, DISTRIBUTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])
}

// ===== EMERGENCY CONTACTS =====

model EmergencyContact {
  id             String   @id @default(cuid())
  name           String
  category       String // HOSPITAL, FIRE_STATION, POLICE, AMBULANCE, UTILITY, NGO, OTHER
  phone          String
  altPhone       String?
  email          String?
  address        String
  latitude       Float?
  longitude      Float?
  isVerified     Boolean  @default(false)
  operatingHours String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ===== COMMUNITY BOARD =====

model CommunityPost {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  category  String // UPDATE, REQUEST, OFFER, QUESTION, ALERT, GRATITUDE
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User          @relation(fields: [authorId], references: [id])
  comments PostComment[]
}

model PostComment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  postId   String
  post     CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User          @relation(fields: [authorId], references: [id])
}

// ===== TASK MANAGEMENT =====

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String    @default("TODO") // TODO, IN_PROGRESS, DONE, CANCELLED
  category    String // RESCUE, LOGISTICS, MEDICAL, REPAIR, CLEANUP, PATROL, OTHER
  dueDate     DateTime?
  location    String?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdById String
  createdBy   User      @relation("TaskCreator", fields: [createdById], references: [id])
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  incidentId  String?
  incident    Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
}

// ===== SUPPLY REQUESTS =====

model SupplyRequest {
  id        String         @id @default(cuid())
  itemName  String
  category  SupplyCategory
  quantity  Int
  unit      String
  urgency   String         @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status    String         @default("PENDING") // PENDING, APPROVED, IN_TRANSIT, DELIVERED, REJECTED
  reason    String         @db.Text
  notes     String?        @db.Text
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  requesterId   String
  requester     User    @relation("SupplyRequester", fields: [requesterId], references: [id])
  fromShelterId String
  fromShelter   Shelter @relation("SupplySource", fields: [fromShelterId], references: [id])
  toShelterId   String
  toShelter     Shelter @relation("SupplyDest", fields: [toShelterId], references: [id])
  approvedById  String?
  approvedBy    User?   @relation("SupplyApprover", fields: [approvedById], references: [id])
}

// ===== AREA ALERTS (ADMIN) =====

model AreaAlert {
  id             String    @id @default(cuid())
  title          String
  message        String    @db.Text
  alertType      String    @default("EMERGENCY") // EMERGENCY, EVACUATION, WARNING, INFO, ALL_CLEAR
  severity       String    @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  targetArea     String // e.g., "Mirpur", "Old Dhaka", "Uttara"
  latitude       Float?
  longitude      Float?
  radiusKm       Float? // affected radius
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  recipientCount Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
}

// ===== BLOOD REGISTRY =====
model BloodRegistry {
  id          String   @id @default(cuid())
  donorName   String
  bloodGroup  String
  phone       String
  location    String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== LOST & FOUND =====
model LostFoundItem {
  id           String   @id @default(cuid())
  itemName     String
  type         String
  description  String   @db.Text
  location     String
  contactName  String
  contactPhone String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
