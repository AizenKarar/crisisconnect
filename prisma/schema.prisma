generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  image       String?
  role        Role     @default(CITIZEN)
  phone       String?
  skills      String?
  isVerified  Boolean  @default(false)
  karmaPoints Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bio     String? @db.Text
  address String?

  incidents      Incident[]
  responses      IncidentResponse[]
  messages       Message[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  missingReports MissingPerson[]
  donations      Donation[]
  communityPosts CommunityPost[]
  postComments   PostComment[]
  tasksCreated   Task[]             @relation("TaskCreator")
  tasksAssigned  Task[]             @relation("TaskAssignee")
  supplyRequests SupplyRequest[]    @relation("SupplyRequester")
  supplyApproved SupplyRequest[]    @relation("SupplyApprover")
  areaAlerts     AreaAlert[]
}

enum Role {
  CITIZEN
  VOLUNTEER
  STAFF
  ADMIN
}

model Incident {
  id          String             @id @default(cuid())
  title       String
  description String             @db.Text
  type        DisasterType
  severity    Severity
  status      IncidentStatus     @default(PENDING)
  latitude    Float
  longitude   Float
  areaName    String?
  address     String?
  imageUrl    String?
  isAnonymous Boolean            @default(false)
  reporterIp  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  reporterId  String?
  reporter    User?              @relation(fields: [reporterId], references: [id])
  responses   IncidentResponse[]
  messages    Message[]
  auditLogs   AuditLog[]
  tasks       Task[]
}

enum DisasterType {
  FIRE
  FLOOD
  EARTHQUAKE
  STORM
  MEDICAL
  INFRASTRUCTURE
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  PENDING
  VERIFIED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model IncidentResponse {
  id        String   @id @default(cuid())
  message   String   @db.Text
  createdAt DateTime @default(now())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Shelter {
  id          String   @id @default(cuid())
  name        String
  address     String
  latitude    Float
  longitude   Float
  maxCapacity Int
  occupied    Int      @default(0)
  status      String   @default("OPEN")
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplies           Supply[]
  supplyRequestsFrom SupplyRequest[] @relation("SupplySource")
  supplyRequestsTo   SupplyRequest[] @relation("SupplyDest")
}

model Supply {
  id        String         @id @default(cuid())
  name      String
  category  SupplyCategory
  quantity  Int
  unit      String
  minLevel  Int            @default(10)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  shelterId String
  shelter   Shelter @relation(fields: [shelterId], references: [id], onDelete: Cascade)
}

enum SupplyCategory {
  FOOD
  WATER
  MEDICINE
  EQUIPMENT
  CLOTHING
  OTHER
}

model MissingPerson {
  id            String   @id @default(cuid())
  name          String
  age           Int
  gender        String
  description   String   @db.Text
  lastSeenPlace String
  lastSeenDate  DateTime
  imageUrl      String?
  contactPhone  String
  contactName   String
  status        String   @default("MISSING")
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reporterId String?
  reporter   User?   @relation(fields: [reporterId], references: [id])
}

model Donation {
  id         String   @id @default(cuid())
  donorName  String
  donorEmail String?
  donorPhone String?
  type       String
  amount     Float?
  itemName   String?
  quantity   Int?
  unit       String?
  message    String?
  status     String   @default("PLEDGED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])
}

model EmergencyContact {
  id             String   @id @default(cuid())
  name           String
  category       String
  phone          String
  altPhone       String?
  email          String?
  address        String
  latitude       Float?
  longitude      Float?
  isVerified     Boolean  @default(false)
  operatingHours String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CommunityPost {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  category  String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User          @relation(fields: [authorId], references: [id])
  comments PostComment[]
}

model PostComment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  postId   String
  post     CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User          @relation(fields: [authorId], references: [id])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  priority    String    @default("MEDIUM")
  status      String    @default("TODO")
  category    String
  dueDate     DateTime?
  location    String?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdById String
  createdBy   User      @relation("TaskCreator", fields: [createdById], references: [id])
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  incidentId  String?
  incident    Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
}

model SupplyRequest {
  id        String         @id @default(cuid())
  itemName  String
  category  SupplyCategory
  quantity  Int
  unit      String
  urgency   String         @default("MEDIUM")
  status    String         @default("PENDING")
  reason    String         @db.Text
  notes     String?        @db.Text
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  requesterId   String
  requester     User    @relation("SupplyRequester", fields: [requesterId], references: [id])
  fromShelterId String
  fromShelter   Shelter @relation("SupplySource", fields: [fromShelterId], references: [id])
  toShelterId   String
  toShelter     Shelter @relation("SupplyDest", fields: [toShelterId], references: [id])
  approvedById  String?
  approvedBy    User?   @relation("SupplyApprover", fields: [approvedById], references: [id])
}

model AreaAlert {
  id             String    @id @default(cuid())
  title          String
  message        String    @db.Text
  alertType      String    @default("EMERGENCY")
  severity       String    @default("HIGH")
  targetArea     String
  latitude       Float?
  longitude      Float?
  radiusKm       Float?
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  recipientCount Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
}

model BloodRegistry {
  id          String   @id @default(cuid())
  donorName   String
  bloodGroup  String
  phone       String
  location    String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LostFoundItem {
  id           String   @id @default(cuid())
  itemName     String
  type         String
  description  String   @db.Text
  location     String
  contactName  String
  contactPhone String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  userName  String?
  userEmail String?
  type      String   @default("GENERAL")
  message   String   @db.Text
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
}
